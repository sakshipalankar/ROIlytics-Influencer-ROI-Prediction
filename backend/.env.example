# ─── ROIlytics Backend Environment ────────────────────────────────────────────
# Copy this file to .env and fill in the values.

# Fernet symmetric encryption key for secure operations at rest.
# Generate with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=2og1m_PYTqPBt8Fmd5l6vhDUo7fehlGmFTo66bi7OWM=

# How long (hours) a cached live profile stays fresh before re-fetching.
CACHE_TTL_HOURS=6

# Business Discovery is blocked for this app (requires Instagram Public
# Content Access). Keep disabled unless you have that permission.
ENABLE_BUSINESS_DISCOVERY=false

# ─── Public Lookup (Playwright Chromium) ─────────────────────────────────────
# OFF by default. If enabled, provides an experimental unauthenticated scraper
# for public profile data.
ENABLE_PUBLIC_LOOKUP=false
PLAYWRIGHT_HEADLESS=false          # Set to true in prod, false for visible debugging
PUBLIC_LOOKUP_MIN_DELAY_SEC=8      # Minimum gap between fetches
PUBLIC_LOOKUP_MAX_PER_HOUR=20      # Scraping budget
PUBLIC_LOOKUP_TIMEOUT_SEC=45
PUBLIC_LOOKUP_MAX_FAILURES=3       # Failures before circuit breaker trips
PUBLIC_LOOKUP_COOLDOWN_MIN=30      # How long to pause on block
PUBLIC_LOOKUP_CACHE_TTL_HOURS=24   # Cache lifespan for scraped data

# Shared reliability thresholds
RELIABLE_MIN_FOLLOWERS=100
RELIABLE_MIN_POSTS=3
# ─── Google OAuth (optional, for user auth) ──────────────────────────────────
# VITE_GOOGLE_CLIENT_ID=

# ─── MySQL (optional, falls back to SQLite for user auth) ────────────────────
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=
# MYSQL_DATABASE=roilytics_db
