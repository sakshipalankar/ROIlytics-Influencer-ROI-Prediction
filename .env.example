# Instagram Graph API credentials
# See README.md for setup instructions
IG_ACCESS_TOKEN=your_long_lived_token_here
IG_USER_ID=your_linked_business_account_id_here

# Optional: path to Kaggle dataset (default: data/kaggle_campaign_data.csv)
# KAGGLE_DATASET_PATH=data/kaggle_campaign_data.csv

# Google OAuth 2.0 Web Client ID (from Google Cloud Console)
# Authorized JavaScript origin must include: http://localhost:5173
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# MySQL Database Configuration (Optional - falls back seamlessly to SQLite)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_root_password_here
MYSQL_DATABASE=roilytics_db
